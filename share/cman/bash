bash-scrip  

if 
	demo    
		// demo1:
		if [ $1 = "filter" ]; then 
		    echo hello world
		fi
		// important, -eq is for arithmetic expr, not for string
		
	demo for else if
		if [[ $A -eq $B ]] 
		then 
			echo hello shell 
		elif [[ $A -eq $B]] 
		then
			echo elif hello
		fi

	1. use ; so that 'than' can be placed in the same line
	2. conditons 
		[[ $A -eq $B ]]
		[[ -n "$A" ]] 	# true if A is not empty, 'n' means not empty
		[[ -z "A" ]] 	# true if A is empty
		check file or directory
		[[ -f "$fname" ]] # for file  
		[[ -d "$dirname" ]] # for dir
		!!! >>> very important !!!, place one between the bracket and cond-expression

	-1. remember to add the "
		or there will be nothing, which leads to a gramma error

