#!/bin/bash

remote=$1
shift 1
filenames=$@
echo $remote 
if [[ "$remote" = "pi" ]]
then 
    echo " scp to pi"
    sshpass -p Mind@123 scp -r $filenames HwHiAiUser@$PI_IP:/home/HwHiAiUser/catman/FlexAscend-master/
elif [[ "$remote" = "huawei" ]]
then
    echo " >>> deprecated "
elif [[ "$remote" = "group" ]]
then 
    echo " >>> scp to group remote"
	# sshpass -p $GROUP_PASSWORD scp -r $filenames $GROUP_USER@$GROUP_IP:/home/llmserver/xulg/
	scp -r $filenames $GROUP_USER@$GROUP_IP:/home/llmserver/xulg/
else
    echo "invalid remote:" $remote
fi
