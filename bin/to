#!/bin/bash

remote=$1
shift 1
filenames=$@
echo $remote


if [[ "$remote" = "pi" ]]
then 
    echo " scp to pi"
    sshpass -p Mind@123 scp -r $filenames root@$PI_IP:/root/$filename
elif [[ "$remote" = "huawei" ]]
then
